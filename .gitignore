# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# This repo is npm-only (`package-lock.json` + `npm ci`). pnpm-lock.yaml is
# stale/unused and must not be re-introduced (issue #1496).
pnpm-lock.yaml

# Virtual environments
venv/
.venv/

# testing
/coverage
/test-results

# mutation testing (Stryker) — issue #1097
/.stryker-tmp
/reports/mutation

# playwright
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Tauri updater signing keys (issue #1403). The PRIVATE key must NEVER be
# committed — only the PUBLIC .pub counterpart belongs in the repo (as the
# value of src-tauri/tauri.conf.json `plugins.updater.pubkey`). The CI
# pipeline reads the private key from the TAURI_SIGNING_PRIVATE_KEY secret.
*.key
*.key.pub
.tauri/
src-tauri/target/
src-tauri/gen/
*.json
# i18n message catalogs must be tracked
!src/messages/*.json
# Differential rules scenarios and their card-data snapshot (#2411)
!scripts/differential/scenarios/*.json
!scripts/differential/cards.snapshot.json
# Card scripts are data and must be tracked (#2488)
!src/lib/game-state/card-scripts/cards/*.json
# Generated card-script index is rebuilt before every dev/build/test/typecheck
# (#2487); committing it forced every card PR to rebase on the index file.
src/lib/game-state/card-scripts/cards/index.generated.ts

# Tauri config + platform overlays must be tracked (tauri.conf.json
# predates the blanket *.json rule; overlays added by #1729 need the
# explicit negation or they are silently ignored).
!src-tauri/tauri.conf.json
!src-tauri/tauri.*.conf.json

# Bundle size budgets must be tracked (issue #1814): the blanket *.json
# rule above would silently ignore the gate's recorded ceilings.
!config/bundle-budget.json

# Standard-legal keyword snapshot for the gap report (issue #2360): the
# blanket *.json rule above would drop the data the report classifies by.
!scripts/data/standard-keywords.json

# npm audit exception list must be tracked (issue #2437): the blanket *.json
# rule above would silently drop it and the audit gate would fail to load it.
!scripts/security/npm-audit-exceptions.json

# Jest mock boundary allowlist must be tracked (issue #1815): the
# blanket *.json rule above would silently ignore the guard's
# documented exceptions.
!config/jest-mock-boundary-allowlist.json

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
nohup.out

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
# CSP nonce written by scripts/inject-tauri-csp-nonce.ts (per-build, never committed)
src/lib/security/csp-nonce.json
.env*

# firebase
firebase-debug.log
firestore-debug.log

# backup files
*.bak
*.backup
*.orig

# Claude Code worktrees — these must live OUTSIDE the repo (issue #1479).
# When committed they appear as gitlinks (mode 160000) with no .gitmodules
# entry, which makes `git submodule status` fail and spams every CI job.
.claude/worktrees/

# scratch / repro files (issue #2299)
DEMO_OPPONENT_GENERATOR.ts
gameboard_screenshot.png
repro_parser.ts
test-serialization.ts
# card-script bake-off output (#2491)
bakeoff-out/
!scripts/data/bakeoff-cards.json
