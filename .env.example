# Planar Nexus Environment Variables

# AI Provider API URLs (optional - defaults to production URLs)
NEXT_PUBLIC_ZAI_API_URL=https://api.z-ai.com/v1
NEXT_PUBLIC_ANTHROPIC_API_URL=https://api.anthropic.com/v1
NEXT_PUBLIC_OPENAI_API_URL=https://api.openai.com/v1
NEXT_PUBLIC_GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1

# AI Provider API Keys (set your own keys)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# ZAI_API_KEY=

# AI Rate Limiting (optional)
# NEXT_PUBLIC_AI_RATE_LIMIT_MAX=10
# NEXT_PUBLIC_AI_RATE_LIMIT_WINDOW_MS=60000
# NEXT_PUBLIC_AI_DEBOUNCE_MS=500

# Conversational coach output-token cap (optional, issue #1536).
# Hard cap forwarded to the LLM for every coach turn; bounds token cost and
# prevents runaway responses. Must be a positive integer. Defaults to 1024
# when unset / invalid. The route /api/chat/coach emits the resolved cap on
# its `usage` SSE event so the client can render the bound.
# COACH_MAX_OUTPUT_TOKENS=1024

# P2P WebRTC TURN relay — short-lived per-session HMAC credentials (issue #1583).
#
# Preferred: server-side HMAC minting. Configure the coturn TURN server with
# `use-auth-secret` + `static-auth-secret` + `realm`, then set the matching
# secret here. The server mints `<expiry-epoch>:<client-id>` usernames and
# base64 HMAC-SHA1 credentials on every request to /api/signaling/turn-credentials
# — the secret never enters the client bundle. Set:
#
# TURN_HMAC_SECRET=replace-with-a-long-random-secret-shared-with-coturn
# TURN_URL=turn:turn.your-domain.com:3478,turns:turn.your-domain.com:5349
# TURN_HMAC_REALM=turn.your-domain.com
# TURN_HMAC_TTL_SECONDS=3600   # default 3600 (1h), max 86400 (24h)
#
# Deprecated: NEXT_PUBLIC_TURN_URL/USER/PASS. These bake the long-term credential
# into the client bundle (issue #1571) and the app will emit a startup warning
# until you migrate. Kept as a transition aid; will be removed in a future release.
# NEXT_PUBLIC_TURN_URL=turn:turn.your-domain.com:3478,turn:turn.your-domain.com:5349
# NEXT_PUBLIC_TURN_USER=your-username
# NEXT_PUBLIC_TURN_PASS=your-credential
